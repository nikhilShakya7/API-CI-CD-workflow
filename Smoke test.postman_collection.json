    {
      "name": "Get single post Copy",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "pm.test(\"Response contains id\", function () {\r",
              "    const response = pm.response.json();\r",
              "\r",
              "    pm.expect(response).to.have.property(\"id\");\r",
              "});\r",
              "\r",
              "pm.test(\"Post ID is 1\", function () {\r",
              "    const response = pm.response.json();\r",
              "\r",
              "    pm.expect(response.id).to.eql(1);\r",
              "});\r",
              "\r",
              "pm.test(\"Response contains title\", function () {\r",
              "    const response = pm.response.json();\r",
              "\r",
              "    pm.expect(response).to.have.property(\"title\");\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
